---
const links = [
  { href: '/', label: 'Home' },
  { href: '/resume', label: 'Resume' },
];
const pathname = Astro.url.pathname;
function isActiveHref(href: string) {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(href + '/');
}
function linkClass(href: string) {
  const active = isActiveHref(href);
  return `rounded-full px-4 py-2 text-sm transition-colors ${active ? 'bg-foreground text-background font-medium' : 'text-muted-foreground hover:bg-muted hover:text-foreground'}`;
}
---
<nav class="sticky top-3 z-50">
  <div class="container mx-auto px-6">
    <div class="flex justify-center">
      <div class="inline-flex items-center gap-1 rounded-full border border-border/70 bg-background/95 p-1.5 shadow-md backdrop-blur-md">
        {links.map((l) => (
          <a href={l.href} class={linkClass(l.href)} aria-current={isActiveHref(l.href) ? 'page' : undefined}>{l.label}</a>
        ))}
      </div>
    </div>
  </div>
</nav>
