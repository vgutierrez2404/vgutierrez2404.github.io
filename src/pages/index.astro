---
import Base from "../layouts/Base.astro";
import siteInfo from "../../public/0user.json";
---

<Base title={siteInfo.site.title}
      description={siteInfo.site.description}>

    <section class="container mx-auto px-6 py-16 flex-grow flex flex-col justify-center">
        <div class="max-w-3xl mx-auto w-full">
            <div class="flex flex-col-reverse sm:flex-row sm:items-center sm:justify-between gap-6 mb-6">
                <div>
                    <h1 class="mb-2 text-4xl md:text-5xl font-bold tracking-tight text-balance">{siteInfo.name}</h1>
                    <p class="text-lg md:text-xl text-muted-foreground">{siteInfo.role}</p>
                </div>
                {siteInfo.home.photo && <img src={siteInfo.home.photo} alt={`Portrait of ${siteInfo.name}`} class="w-32 h-32 rounded-full object-cover border border-border" />}
            </div>

            <p class="mb-4 text-base md:text-lg text-foreground/85 leading-relaxed text-pretty">
                {siteInfo.home.bio}
            </p>
            <p class="mb-10 text-base md:text-lg text-foreground/85 leading-relaxed text-pretty">
                {siteInfo.home.note}
            </p>

            <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
                {siteInfo.contacts.map((contact) => (
                        <div>
                            [{contact.label}: <a
                                href={contact.href}
                                target={contact.target}
                                rel={contact.rel}
                                class="text-muted-foreground underline underline-offset-2 decoration-accent/50 hover:text-accent hover:decoration-accent transition-colors"
                        >{contact.text}</a>]
                        </div>
                ))}
            </div>

            {siteInfo.home.news?.length > 0 && <section class="mt-12">
                <h2 class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-3">News</h2>
                <ul class="list-disc pl-5 space-y-2 text-sm text-foreground/85">
                    {siteInfo.home.news.map((item) => <li><a href={item.href} target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 decoration-accent/50 hover:text-accent">{item.linkText}</a> {item.text.replace(item.linkText, "").trim()}</li>)}
                </ul>
            </section>}

            {siteInfo.home.research && <section class="mt-12">
                <h2 class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-3">Research</h2>
                <p class="text-sm md:text-base text-foreground/85 leading-relaxed">{siteInfo.home.research}</p>
            </section>}

            {siteInfo.home.publications?.length > 0 && <section class="mt-12">
                <h2 class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-4">Publications</h2>
                <div class="space-y-6">
                    {siteInfo.home.publications.map((publication) => <article class="grid grid-cols-1 sm:grid-cols-[9rem_1fr] gap-4 border-t border-border/60 pt-5">
                        <img src={publication.image} alt={publication.imageAlt} class="w-full rounded-md border border-border/60" loading="lazy" />
                        <div>
                            <h3 class="font-semibold leading-snug">{publication.title}</h3>
                            <p class="mt-1 text-xs text-muted-foreground">{publication.authors}</p>
                            <p class="mt-1 text-xs italic text-muted-foreground">{publication.venue}</p>
                            <p class="mt-3 text-sm text-foreground/80 leading-relaxed">{publication.description}</p>
                            <div class="mt-3 flex gap-3 text-xs">
                                {publication.links.map((link) => <a href={link.href} target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 decoration-accent/50 hover:text-accent">{link.label}</a>)}
                            </div>
                        </div>
                    </article>)}
                </div>
            </section>}
        </div>
    </section>

</Base>
