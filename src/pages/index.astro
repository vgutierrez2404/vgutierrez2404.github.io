---
import Base from "../layouts/Base.astro";
import InlineText from "../components/InlineText.astro";
import { Image } from 'astro:assets';
import profilePhoto from '../assets/me.jpeg';
import pancImage from '../assets/panc_before.png';
import hitlImage from '../assets/hitl_before.png';
import siteInfo from "../../public/0user.json";

const imageAssets = {
    me: profilePhoto,
    panc_before: pancImage,
    hitl_before: hitlImage,
};
function imageFor(id: string) {
    return imageAssets[id as keyof typeof imageAssets] ?? profilePhoto;
}
---

<Base title={siteInfo.site.title}
      description={siteInfo.site.description}>

    <section class="container mx-auto px-6 py-10 md:py-12">
        <div class="max-w-3xl mx-auto w-full">
            <div class="flex flex-col-reverse sm:flex-row sm:items-center sm:justify-between gap-6 mb-6">
                <div>
                    <h1 class="mb-2 text-3xl md:text-4xl font-bold tracking-tight text-balance">{siteInfo.name}</h1>
                    <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
                        {siteInfo.contacts.filter((contact) => ['email', 'GitHub', 'LinkedIn'].includes(contact.label)).map((contact) => (
                            contact.label === 'GitHub' || contact.label === 'LinkedIn' ? (
                                <a
                                    href={contact.href}
                                    target={contact.target}
                                    rel={contact.rel}
                                    class="text-muted-foreground underline underline-offset-2 decoration-accent/50 hover:text-accent hover:decoration-accent transition-colors"
                                >{contact.label}</a>
                            ) : (
                                <div>
                                    [{contact.label}: <a
                                        href={contact.href}
                                        target={contact.target}
                                        rel={contact.rel}
                                        class="text-muted-foreground underline underline-offset-2 decoration-accent/50 hover:text-accent hover:decoration-accent transition-colors"
                                    >{contact.text}</a>]
                                </div>
                            )
                        ))}
                    </div>
                </div>
                {siteInfo.home.photo && <Image src={imageFor(siteInfo.home.photo)} alt={`Portrait of ${siteInfo.name}`} class="w-32 h-32 rounded-full object-cover border border-border" format="webp" quality={80} />}
            </div>

            <p class="mb-4 text-sm md:text-base text-foreground/85 leading-relaxed text-pretty">
                <InlineText text={siteInfo.home.bio} />
            </p>
            <p class="mb-10 text-sm md:text-base text-foreground/85 leading-relaxed text-pretty">
                <InlineText text={siteInfo.home.note} />
            </p>

            <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
                {siteInfo.contacts.filter((contact) => !['email', 'GitHub', 'LinkedIn', 'GAPS-UPM'].includes(contact.label)).map((contact) => (
                        <div>
                            [{contact.label}: <a
                                href={contact.href}
                                target={contact.target}
                                rel={contact.rel}
                                class="text-muted-foreground underline underline-offset-2 decoration-accent/50 hover:text-accent hover:decoration-accent transition-colors"
                        >{contact.text}</a>]
                        </div>
                ))}
            </div>

            {siteInfo.home.news?.length > 0 && <section class="mt-12">
                <h2 class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-3">News</h2>
                <ul class="list-disc pl-5 space-y-2 text-sm text-foreground/85">
                    {siteInfo.home.news.map((item) => <li>
                        {item.date && <>
                            <time dateTime={item.date} class="text-muted-foreground">{new Date(`${item.date}T00:00:00`).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}</time>{" — "}
                        </>}
                        <a href={item.href} target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 decoration-accent/50 hover:text-accent">{item.linkText}</a> {item.text.replace(item.linkText, "").trim()}
                    </li>)}
                </ul>
            </section>}

            {siteInfo.home.research && <section class="mt-12">
                <h2 class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-3">Research</h2>
                <p class="text-sm md:text-base text-foreground/85 leading-relaxed"><InlineText text={siteInfo.home.research} /></p>
            </section>}

            {siteInfo.home.publications?.length > 0 && <section class="mt-12">
                <h2 class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-4">Publications</h2>
                <div class="space-y-6">
                    {siteInfo.home.publications.map((publication) => <article class="grid grid-cols-1 sm:grid-cols-[9rem_1fr] gap-4 border-t border-border/60 pt-5">
                        <Image src={imageFor(publication.image)} alt={publication.imageAlt} class="w-full rounded-md border border-border/60" loading="lazy" format="webp" quality={80} />
                        <div>
                            <h3 class="font-semibold leading-snug">{publication.title}</h3>
                            <p class="mt-1 text-xs text-muted-foreground">{publication.authors}</p>
                            <p class="mt-1 text-xs italic text-muted-foreground">{publication.venue}</p>
                            <p class="mt-3 text-sm text-foreground/80 leading-relaxed"><InlineText text={publication.description} /></p>
                            <div class="mt-3 flex gap-3 text-xs">
                                {publication.links.map((link) => <a href={link.href} target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 decoration-accent/50 hover:text-accent">{link.label}</a>)}
                            </div>
                        </div>
                    </article>)}
                </div>
            </section>}
        </div>
    </section>

</Base>
